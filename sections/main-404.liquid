{%- comment -%}
  Lena: the styles for this page live in assets/lena-custom.css, under "404 page".
  They used to sit inline at the top of this file, 132 lines of them, which broke the
  rule in CLAUDE.md that all custom styles go in one place - and meant they were
  invisible to anyone grepping lena-custom.css for a .lena-404__ class, re-downloaded
  on every 404 instead of cached with the rest of the theme, and outside the cascade
  order everything else is reasoned about in.
{%- endcomment -%}

<div class="lena-404 page-width">
  <div class="lena-404__diamond">
    <span class="dm filled"></span>
    <span class="dm filled gold"></span>
    <span class="dm filled"></span>
  </div>

  <p class="lena-404__code">404</p>
  <h1 class="lena-404__title">{{ 'templates.404.title' | t }}</h1>
  <p class="lena-404__text">
    The page you're looking for may have been moved or is no longer available.
    Try searching for what you need or browse our collections below.
  </p>

  <div class="lena-404__search">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="search"
        name="q"
        placeholder="Search for products..."
        aria-label="Search"
      >
      {%- comment -%} Lena: search products only. Without this Shopify also searches pages
           and blog posts, and they render as cards in the product grid with no photo,
           price or button - which reads as a broken product. {%- endcomment -%}
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>

  <div class="lena-404__links">
    <a href="{{ routes.collections_url }}" class="lena-404__link">All Collections</a>
    <a href="{{ routes.all_products_collection_url }}" class="lena-404__link">All Products</a>
    <a href="{{ routes.collections_url }}/available-now" class="lena-404__link">Available Now</a>
    <a href="/pages/contact" class="lena-404__link">Contact Us</a>
  </div>

  <a href="{{ routes.root_url }}" class="lena-404__home">
    Back to Home
  </a>
</div>
