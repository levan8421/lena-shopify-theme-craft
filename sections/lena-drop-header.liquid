{%- comment -%}
  Drop header section — adapts messaging based on whether the
  linked collection has products or is empty (between drops).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign drop_collection = collections[section.settings.collection_handle] -%}
{%- assign has_products = false -%}
{%- if drop_collection != blank and drop_collection.products.size > 0 -%}
  {%- assign has_products = true -%}
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="lena-drop-bar">
    <div>
      <div class="lena-section-eye"><span class="dm filled sm"></span> {{ section.settings.eyebrow }}</div>
      {%- if has_products -%}
        <div class="lena-section-h">This Week's <strong>Drop</strong></div>
      {%- else -%}
        <div class="lena-section-h">New Drop <strong>Coming Soon</strong></div>
      {%- endif -%}
    </div>
    <div style="display:flex;align-items:center;gap:14px">
      <div class="lena-countdown-pill">
        <span class="dm filled sm" style="animation:dm-pulse 1.5s infinite"></span>
        <span id="lena-countdown">Next drop soon</span>
      </div>
      {%- if has_products -%}
        <a class="lena-view-all" href="{{ drop_collection.url }}">View all &rarr;</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function(){
  function update(){
    var now=new Date();
    var fri=new Date(now);
    fri.setDate(now.getDate()+((5-now.getDay()+7)%7||7));
    fri.setHours(20,0,0,0);
    if(now.getDay()===5&&now.getHours()<20){fri.setDate(now.getDate());}
    var diff=fri-now;
    if(diff<=0){document.getElementById('lena-countdown').textContent='Drop is LIVE!';return;}
    var d=Math.floor(diff/864e5),h=Math.floor(diff%864e5/36e5),m=Math.floor(diff%36e5/6e4);
    document.getElementById('lena-countdown').textContent='Next drop in '+d+'d '+h+'h '+m+'m';
  }
  update();setInterval(update,60000);
})();
</script>

{% schema %}
{
  "name": "Drop Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh From Vietnam"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "new-arrivals",
      "info": "The handle of the drop collection (from the URL). Used to detect whether products are available."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Drop Header"
    }
  ]
}
{% endschema %}
