{%- comment -%}
  New Arrivals bar — a heading plus a linked count, nothing more.

  The section renders only while the linked collection holds products, and is
  absent entirely otherwise. There is deliberately no empty-state copy: an
  "arrivals" heading over nothing is the dormant framing this replaced.

  Visibility is the collection's product count and nothing else — no date
  window, no staleness read, no cap. The app owns what "new" means and how long
  it lasts, via a single tag; the theme only reflects the result.
{%- endcomment -%}

{%- liquid
  assign na_collection = collections[section.settings.collection_handle]
  comment
    all_products_count is the collection total. The similarly named products_count
    reflects the current tag-filtered view, which is not what visibility should
    hinge on.
  endcomment
  assign na_count = 0
  if na_collection != blank
    assign na_count = na_collection.all_products_count
  endif
-%}

{%- if na_count > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="lena-drop-bar">
      <div>
        <div class="lena-section-eye"><span class="dm filled sm"></span> {{ section.settings.eyebrow }}</div>
        <h2 class="lena-section-h">{{ section.settings.heading }}</h2>
      </div>
      <a class="lena-view-all" href="{{ na_collection.url }}">
        {{ na_count }} new {% if na_count == 1 %}piece{% else %}pieces{% endif %} &rarr;
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh From Vietnam"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "New <strong>Arrivals</strong>"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "new-arrivals",
      "info": "From the collection URL. The whole section is hidden while this collection is empty."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
