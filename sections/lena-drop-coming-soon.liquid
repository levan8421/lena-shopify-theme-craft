{%- comment -%}
  Empty-state section for a collection page, rendered only while the collection
  holds no products.

  This is the soft landing for someone who reaches an empty collection directly
  — a bookmark, a printed card, a search result — rather than through the nav,
  which hides the link. It always offers an onward CTA, never a dead end.
{%- endcomment -%}

{%- if collection.products.size == 0 -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="lena-coming-soon page-width" style="padding:60px 24px 80px;text-align:center;max-width:680px;margin:0 auto">
    <div class="lena-section-eye" style="margin-bottom:12px">
      <span class="dm filled sm"></span> {{ section.settings.eyebrow }}
    </div>
    <h2 class="lena-section-h" style="margin-bottom:16px">
      {{ section.settings.heading }}
    </h2>
    <p style="font-size:16px;line-height:1.7;color:rgba(14,34,64,0.7);margin-bottom:28px">
      {{ section.settings.description }}
    </p>

    {%- comment -%}
      The button is skipped rather than rendered with an empty href. The schema
      cannot carry a sensible default here: Shopify accepts only "/collections"
      and "/collections/all" as the default for a url setting, and both JSON
      templates already supply the real link.
    {%- endcomment -%}
    {%- if section.settings.cta_link != blank -%}
      <div>
        <a href="{{ section.settings.cta_link }}" class="button" style="min-width:220px">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- endif -%}

{% schema %}
{
  "name": "Collection Empty State",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh From Vietnam"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "New <strong>Arrivals</strong>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We're preparing something special. Every piece is handcrafted by artisans in Vietnam \u2014 made in small numbers, most of them one of a kind. Check back soon, or explore what's available now."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "All Available Pieces"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Required — the button is hidden until this is set. Shopify allows no useful default for a link field."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
