{%- comment -%}
  "Coming soon" section for the This Week's Drop collection page.
  Only renders when the collection is empty (between drops).
  Shows countdown to next Friday + CTA to browse available stock.
{%- endcomment -%}

{%- if collection.products.size == 0 -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="lena-coming-soon page-width" style="padding:60px 24px 80px;text-align:center;max-width:680px;margin:0 auto">
    <div class="lena-section-eye" style="margin-bottom:12px">
      <span class="dm filled sm"></span> {{ section.settings.eyebrow }}
    </div>
    <h2 class="lena-section-h" style="margin-bottom:16px">
      {{ section.settings.heading }}
    </h2>
    <p style="font-size:16px;line-height:1.7;color:rgba(14,34,64,0.7);margin-bottom:28px">
      {{ section.settings.description }}
    </p>

    {%- if section.settings.show_countdown -%}
      <div class="lena-countdown-pill" style="display:inline-flex;margin-bottom:32px">
        <span class="dm filled sm" style="animation:dm-pulse 1.5s infinite"></span>
        <span id="lena-drop-page-countdown">Next drop soon</span>
      </div>
    {%- endif -%}

    <div>
      <a href="{{ section.settings.cta_link }}" class="button" style="min-width:220px">
        {{ section.settings.cta_label }}
      </a>
    </div>
  </div>
</div>

{%- if section.settings.show_countdown -%}
<script>
(function(){
  var customDate = '{{ section.settings.next_drop_date | escape }}';
  function update(){
    var el=document.getElementById('lena-drop-page-countdown');
    if(!el) return;
    var now=new Date();

    // --- Find drop start (Friday 11:00 UTC = 6 AM EST) ---
    var dropStart;
    if(customDate && customDate.trim()){
      dropStart=new Date(customDate.trim());
      if(isNaN(dropStart.getTime())) dropStart=null;
    }
    if(!dropStart){
      var daysSinceFri=(now.getUTCDay()+2)%7;
      dropStart=new Date(now);
      dropStart.setUTCDate(now.getUTCDate()-daysSinceFri);
      dropStart.setUTCHours(11,0,0,0);
      if(dropStart>now) dropStart.setUTCDate(dropStart.getUTCDate()-7);
    }

    // --- Drop end: Monday 05:00 UTC (= Sunday midnight EST) ---
    var dropEnd=new Date(dropStart);
    dropEnd.setUTCDate(dropStart.getUTCDate()+3);
    dropEnd.setUTCHours(5,0,0,0);

    if(now>=dropStart && now<dropEnd){
      el.textContent='Drop is LIVE!';
      return;
    }

    // --- Countdown to next Friday 11:00 UTC ---
    var next=new Date(dropStart);
    next.setUTCDate(dropStart.getUTCDate()+7);
    var diff=next-now;
    var d=Math.floor(diff/864e5),h=Math.floor(diff%864e5/36e5),m=Math.floor(diff%36e5/6e4);
    el.textContent='Next drop in '+d+'d '+h+'h '+m+'m';
  }
  update();setInterval(update,60000);
})();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Drop Coming Soon",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh From Vietnam"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "New Drop <strong>Coming Soon</strong>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We're preparing something special. Every piece is handcrafted by artisans in Vietnam \u2014 one of a kind, made just for you. Check back Friday, or explore what's available now."
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": false,
      "info": "Turn on when the drop schedule is finalized."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Available Pieces"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "next_drop_date",
      "label": "Next drop date & time",
      "default": "",
      "info": "Format: 2026-06-13 06:00. Leave blank to auto-target next Friday 6 AM EST. Keep in sync with Drop Header section."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
