{%- comment -%}
  Lena: the padding sliders below were declared in the schema but never rendered - no style
  block, no padding class - so dragging them in the theme editor did nothing at all. Both are
  stored at 0, which is why nobody noticed. Wired up here in the same shape every other Lena
  section uses.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="lena-hero section-{{ section.id }}-padding">
  <div class="lena-hero-bg"></div>
  <div class="lena-hero-content">
    <div class="lena-hero-text">
      <div class="lena-hero-eyebrow"><span class="dm gold sm"></span> {{ section.settings.eyebrow }}</div>
      {%- comment -%}
        Lena: the theme editor writes this field back wrapped in <p>...</p> every time it is
        saved, even though the setting is inline_richtext. That put a block-level <p> inside
        the H1, which is invalid and adds the paragraph margin on top of the h1 margin - a
        visible gap between the heading and the subheading. Stripping it here means the stored
        value no longer matters, so an admin save cannot reintroduce it. Fixed once in
        templates/index.json before; it came straight back in commit 2ca5914.
      {%- endcomment -%}
      {%- assign lena_heading = section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -%}
      <h1>{{ lena_heading }}</h1>
      <p class="lena-hero-sub">{{ section.settings.subheading }}</p>
      <div class="lena-hero-ctas">
        {% if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank %}
          <a class="lena-btn lena-btn-primary" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 }}</a>
        {% endif %}
        {% if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank %}
          <a class="lena-btn lena-btn-ghost" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
        {% endif %}
      </div>
    </div>
    <div class="lena-hero-mosaic">
      {%- for block in section.blocks -%}
        {%- comment -%}
          Lena: the link needs a name and the image needs alt text.

          image_tag emits alt="" when the file has no alt set in Shopify Files, which is the
          default. With nothing else inside the anchor, a screen reader announced four
          consecutive links as just "link", with no hint of where any of them went. The
          tag_label that names them visually sits outside the anchor, so it never counted.

          The anchor is also skipped entirely when no collection is chosen, rather than being
          emitted with no href - which produced an anchor that looked clickable and was not.

          The two inline styles here were removed, not moved: .lena-hero-img a and
          .lena-hero-img img in lena-custom.css already declare exactly the same rules.
        {%- endcomment -%}
        {%- liquid
          assign lena_dest = block.settings.collection
          assign lena_label = block.settings.tag_label | default: lena_dest.title
          assign lena_alt = block.settings.image.alt | default: lena_label
        -%}
        <div class="lena-hero-img" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if lena_dest != blank -%}
              <a href="{{ lena_dest.url }}"{% if lena_label != blank %} aria-label="{{ lena_label | escape }}"{% endif %}>
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: lena_alt }}
              </a>
            {%- else -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: lena_alt }}
            {%- endif -%}
          {%- else -%}
            <div class="lena-hero-img-ph">{{ block.settings.placeholder_text }}</div>
          {%- endif -%}
          {% if block.settings.tag_label != blank %}
            <span class="img-tag">{{ block.settings.tag_label }}</span>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lena Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Hand-Embroidered in Vietnam"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Bold and italic only. This is the page's H1, so it must not contain a paragraph.",
      "default": "One piece at a time.<br><strong>Yours alone.</strong>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every mirror, hat, and crochet figure in our gallery is hand-embroidered by artisans in Vietnam. Most pieces are one of a kind, handmade in small numbers."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop Available Pieces"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Join the List"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "mosaic_image",
      "name": "Mosaic image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to collection"
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tag label",
          "info": "Small label shown at bottom of image"
        },
        {
          "type": "text",
          "id": "placeholder_text",
          "label": "Placeholder text",
          "info": "Shown when no image is assigned"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lena Hero",
      "blocks": [
        {
          "type": "mosaic_image",
          "settings": {
            "tag_label": "Compact Mirrors",
            "placeholder_text": "Lifestyle photo: Hands embroidering a compact mirror"
          }
        },
        {
          "type": "mosaic_image",
          "settings": {
            "tag_label": "Crochet Figures",
            "placeholder_text": "Crochet figure on styled surface"
          }
        },
        {
          "type": "mosaic_image",
          "settings": {
            "tag_label": "Hats",
            "placeholder_text": "Ribbon-embroidery hat worn / in-context"
          }
        },
        {
          "type": "mosaic_image",
          "settings": {
            "tag_label": "New Arrivals",
            "placeholder_text": "Flat-lay of a curated set"
          }
        }
      ]
    }
  ]
}
{% endschema %}
