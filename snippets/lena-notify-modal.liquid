{%- comment -%}
  Category-specific notify modal for sold-out products.
  Rendered once in theme.liquid. Cards call window.lenaNotify(label, handle).
  Tags contact with: newsletter, notify-{handle}
{%- endcomment -%}

<div id="lena-notify-overlay" class="lena-popup-overlay" style="display:none">
  <div class="lena-popup lena-notify-popup" role="dialog" aria-modal="true" aria-label="Product notification signup">
    <button class="lena-popup-close" aria-label="Close">&times;</button>
    <div class="lena-popup-content">
      <span class="dm filled sm"></span>
      <h2>Get Notified</h2>
      <p>We'll email you when new <strong id="lena-notify-cat-label">items</strong> arrive.</p>
      <form id="lena-notify-form" method="post" action="/contact">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="&#x2713;">
        <input type="hidden" name="contact[tags]" id="lena-notify-tags" value="newsletter">
        <div class="lena-popup-field">
          <input type="email" name="contact[email]" placeholder="Your email" required
            autocomplete="email" autocapitalize="off">
          <button type="submit">Notify Me</button>
        </div>
      </form>
      <div class="lena-notify-success lena-popup-success" style="display:none">
        <span class="dm gold sm"></span> You'll be the first to know!
      </div>
      <div class="lena-notify-error lena-popup-error" style="display:none" role="alert">
        That didn't go through. Please check your connection and try again.
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var overlay = document.getElementById('lena-notify-overlay');
  if (!overlay) return;
  var catLabel = document.getElementById('lena-notify-cat-label');
  var tagsInput = document.getElementById('lena-notify-tags');
  var form = document.getElementById('lena-notify-form');
  var success = overlay.querySelector('.lena-notify-success');
  var error = overlay.querySelector('.lena-notify-error');

  // --- focus handling -------------------------------------------------------
  // Both overlays declare role="dialog" aria-modal="true", which tells assistive
  // technology the rest of the page is inert. Neither moved focus, trapped it, or
  // gave it back - so focus stayed behind the dialog, Tab walked out into the page
  // underneath, and everything it reached was content the page had just declared
  // did not exist. body overflow:hidden stopped the mouse scrolling but not the
  // keyboard.
  var lastFocus = null;

  function focusable() {
    return overlay.querySelectorAll(
      'button:not([disabled]), [href], input:not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])'
    );
  }

  function isOpen() { return overlay.style.display !== 'none'; }

  function trapTab(e) {
    if (e.key !== 'Tab') return;
    var f = focusable();
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function takeFocus() {
    lastFocus = document.activeElement;
    document.addEventListener('keydown', trapTab);
    var target = overlay.querySelector('input[type="email"]') || overlay.querySelector('.lena-popup-close');
    if (target) { target.focus(); }
  }

  function releaseFocus() {
    document.removeEventListener('keydown', trapTab);
    if (lastFocus && typeof lastFocus.focus === 'function') { lastFocus.focus(); }
    lastFocus = null;
  }

  function show(label, handle) {
    catLabel.textContent = label || 'items';
    tagsInput.value = 'newsletter,notify-' + (handle || 'general');
    form.style.display = '';
    success.style.display = 'none';
    error.style.display = 'none';
    form.querySelector('input[type="email"]').value = '';
    overlay.style.display = '';
    document.body.style.overflow = 'hidden';
    takeFocus();
  }
  function hide() {
    if (!isOpen()) return;
    overlay.style.display = 'none';
    document.body.style.overflow = '';
    releaseFocus();
  }

  overlay.querySelector('.lena-popup-close').addEventListener('click', hide);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) hide(); });
  // Guarded on isOpen: this listener lives for the life of the page, so unguarded it
  // ran on every Escape whether or not the dialog was on screen.
  document.addEventListener('keyup', function(e) { if (e.key === 'Escape' && isOpen()) hide(); });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    error.style.display = 'none';
    fetch('/contact', { method: 'POST', body: new FormData(form) })
      .then(function(response) {
        // Without this check every outcome reached the success branch, so a failed
        // signup still read "You'll be the first to know!".
        if (!response.ok) { throw new Error('HTTP ' + response.status); }
        form.style.display = 'none';
        success.style.display = '';
        setTimeout(hide, 2500);
      })
      .catch(function() {
        // Leave the form in place and filled in, so retrying costs one click.
        error.style.display = '';
      });
  });

  window.lenaNotify = show;
})();
</script>
