{
  "sections": {
    "lena-hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"lena-hero\">\n  <div class=\"lena-hero-bg\"></div>\n  <div class=\"lena-hero-content\">\n    <div class=\"lena-hero-text\">\n      <div class=\"lena-hero-eyebrow\"><span class=\"dm gold sm\"></span> Hand-Embroidered in Vietnam</div>\n      <h1>One piece at a time.<br><strong>Yours alone.</strong></h1>\n      <p class=\"lena-hero-sub\">Every mirror, hat, and crochet figure in our gallery is a one-of-one &mdash; hand-embroidered by artisans in Vietnam. New drops every Friday.</p>\n      <div class=\"lena-hero-ctas\">\n        <a class=\"lena-btn lena-btn-primary\" href=\"/collections/this-weeks-drop\">Shop This Week's Drop</a>\n        <a class=\"lena-btn lena-btn-ghost\" href=\"#newsletter\">Join the Drop List</a>\n      </div>\n    </div>\n    <div class=\"lena-hero-mosaic\">\n      <div class=\"lena-hero-img\"><div class=\"lena-hero-img-ph\">Lifestyle photo:<br>Hands embroidering<br>a compact mirror</div><span class=\"img-tag\">Compact Mirrors</span></div>\n      <div class=\"lena-hero-img\"><div class=\"lena-hero-img-ph\">Crochet figure<br>on styled surface</div><span class=\"img-tag\">Crochet Figures</span></div>\n      <div class=\"lena-hero-img\"><div class=\"lena-hero-img-ph\">Ribbon-embroidery hat<br>worn / in-context</div><span class=\"img-tag\">Hats</span></div>\n      <div class=\"lena-hero-img\"><div class=\"lena-hero-img-ph\">Flat-lay of<br>this week's drop<br>curated set</div><span class=\"img-tag\">New This Week</span></div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "lena-trust": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"lena-trust-strip\">\n  <div class=\"lena-trust-inner\">\n    <div class=\"lena-trust-item\">\n      <div class=\"lena-trust-icon ti-hand\"><span>&#9995;</span></div>\n      <div class=\"lena-trust-text\"><strong>100% Handmade</strong><span>Crafted in Vietnam</span></div>\n    </div>\n    <div class=\"lena-trust-item\">\n      <div class=\"lena-trust-icon ti-one\"><span>&#9671;</span></div>\n      <div class=\"lena-trust-text\"><strong>Each Piece Is 1 of 1</strong><span>Once it's gone, it's gone</span></div>\n    </div>\n    <div class=\"lena-trust-item\">\n      <div class=\"lena-trust-icon ti-own\"><span>&#9792;</span></div>\n      <div class=\"lena-trust-text\"><strong>Women-Owned</strong><span>Supporting artisan families</span></div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "lena-drop-header": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"lena-drop-bar\">\n  <div>\n    <div class=\"lena-section-eye\"><span class=\"dm filled sm\"></span> Fresh From Vietnam</div>\n    <div class=\"lena-section-h\">This Week's <strong>Drop</strong></div>\n  </div>\n  <div style=\"display:flex;align-items:center;gap:14px\">\n    <div class=\"lena-countdown-pill\">\n      <span class=\"dm filled sm\" style=\"animation:dm-pulse 1.5s infinite\"></span>\n      <span id=\"lena-countdown\">Next drop soon</span>\n    </div>\n    <a class=\"lena-view-all\" href=\"/collections/this-weeks-drop\">View all &rarr;</a>\n  </div>\n</div>\n<script>\n(function(){\n  function update(){\n    var now=new Date();\n    var fri=new Date(now);\n    fri.setDate(now.getDate()+((5-now.getDay()+7)%7||7));\n    fri.setHours(20,0,0,0);\n    if(now.getDay()===5&&now.getHours()<20){fri.setDate(now.getDate());}\n    var diff=fri-now;\n    if(diff<=0){document.getElementById('lena-countdown').textContent='Drop is LIVE!';return;}\n    var d=Math.floor(diff/864e5),h=Math.floor(diff%864e5/36e5),m=Math.floor(diff%36e5/6e4);\n    document.getElementById('lena-countdown').textContent='Next drop in '+d+'d '+h+'h '+m+'m';\n  }\n  update();setInterval(update,60000);\n})();\n</script>",
        "color_scheme": "scheme-2",
        "padding_top": 52,
        "padding_bottom": 0
      }
    },
