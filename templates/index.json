    "lena-spotlight": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"text-align:center;margin-bottom:40px\">\n  <div class=\"lena-section-eye\" style=\"color:var(--lena-amber-soft)\"><span class=\"dm gold sm\"></span> Artisan Spotlight</div>\n  <div class=\"lena-section-h\" style=\"color:white\">Meet the <strong>Makers</strong></div>\n</div>\n<div class=\"lena-spot-card\">\n  <div class=\"lena-spot-photo\">\n    <div class=\"lena-spot-photo-inner\">Artisan<br>portrait<br>photo</div>\n  </div>\n  <div class=\"lena-spot-text\">\n    <div class=\"lena-spot-role\">Featured Artisan &middot; June 2026</div>\n    <h3>The Crochet Artist</h3>\n    <p>Each crochet figure takes 4&ndash;8 hours to complete by hand. From selecting yarn colors to shaping tiny details &mdash; flower crowns, button eyes, miniature accessories &mdash; every piece reflects years of practice and a deep love for the craft.</p>\n  </div>\n</div>",
        "color_scheme": "scheme-4",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "lena-find-us": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"text-align:center;margin-bottom:40px\">\n  <div class=\"lena-section-eye\"><span class=\"dm filled sm\"></span> In Person</div>\n  <div class=\"lena-section-h\">Find Us This <strong>Weekend</strong></div>\n  <div class=\"lena-section-p\">See and feel the craftsmanship in person.</div>\n</div>\n<div class=\"lena-find-grid\">\n  <div class=\"lena-find-card primary\">\n    <div class=\"fc-i\">&#128205;</div>\n    <h3>West Palm Beach Antique &amp; Flea Market</h3>\n    <div class=\"fc-sched\">Every Saturday &middot; 8:30 AM &ndash; 1:30 PM</div>\n    <p>Our flagship weekly market. Come early for first pick &mdash; many pieces sell out before noon.</p>\n    <a class=\"lena-fc-dir\" href=\"#\">Get directions &rarr;</a>\n  </div>\n  <div class=\"lena-find-card\">\n    <div class=\"fc-i\">&#127978;</div>\n    <h3>Kollective &mdash; Delray Beach</h3>\n    <div class=\"fc-sched\">Open daily &middot; Atlantis Ave</div>\n    <p>Curated purses and mirrors alongside other artisan brands.</p>\n    <a class=\"lena-fc-dir\" href=\"#\">Get directions &rarr;</a>\n  </div>\n  <div class=\"lena-find-card\">\n    <div class=\"fc-i\">&#127978;</div>\n    <h3>Kollective &mdash; Fort Lauderdale</h3>\n    <div class=\"fc-sched\">Open daily &middot; Las Olas Blvd</div>\n    <p>Signature velvet purses and select accessories on Las Olas Boulevard.</p>\n    <a class=\"lena-fc-dir\" href=\"#\">Get directions &rarr;</a>\n  </div>\n</div>",
        "color_scheme": "scheme-2",
