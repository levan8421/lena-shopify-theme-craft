    "our-story": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Our Story",
            "text_style": "subtitle",
            "text_size": "small"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "From a small village in <strong>Vietnam<\/strong> to your hands",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every piece at Lena Handicrafts begins with a story \u2014 of artisans in Vietnam who transform thread, fabric, and yarn into one-of-a-kind works of art using techniques passed down through generations.</p><p>What started as a personal trip back to Vietnam became a mission: to bring the beauty of Vietnamese ribbon embroidery, hand-crocheting, and traditional weaving to the world \u2014 one unique piece at a time.</p>",
            "text_style": "body"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Read the full story",
            "button_link": "/pages/our-story",
            "outline_button": true
          }
        }
      },
      "block_order": ["caption", "heading", "text", "button"],
